{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": false,
    "verbatimModuleSyntax": true,
    "types": ["@lynx-js/rspeedy/client", "vue-lynx/types"]
  },
  "vueCompilerOptions": { "plugins": ["vue-lynx/types/volar-plugin"] },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.vue", "lynx.config.ts"]
}
